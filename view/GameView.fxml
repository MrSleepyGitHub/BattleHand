<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.GameController"
            prefWidth="700.0" stylesheets="@/view/style.css" alignment="CENTER">

        <!-- Header -->
        <Label styleClass="padding-medium" style="-fx-font-weight: bold; -fx-font-size: 18pt">Battle Hand</Label>
        <Separator/>

        <!-- Spacer -->
        <Region VBox.vgrow="ALWAYS"/>
        <Separator/>

        <!-- Buttons -->
        <HBox alignment="CENTER">
            <Button text="Deal" onAction="#handleDeal" HBox.hgrow="ALWAYS" maxWidth="Infinity" style="-fx-background-radius: 0;"/>
        </HBox>

</VBox>