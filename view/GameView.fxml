<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.GameController"
            prefWidth="700.0" stylesheets="@/view/style.css" alignment="CENTER">

        <!-- Header -->
        <Label styleClass="padding-medium" style="-fx-font-weight: bold; -fx-font-size: 18pt">Battle Hand</Label>
        <Separator/>

        <!-- Spacer -->
        <Region VBox.vgrow="ALWAYS"/>
        <Separator/>

        <!-- Weaken input field -->
        <HBox alignment="CENTER" spacing="10">
            <Label text="Weaken:"/>
            <TextField fx:id="weakenField" prefWidth="100.0"/>
        </HBox>

        <Separator/>

        <!-- Buttons -->
        <HBox alignment="CENTER">
            <Button text="Deal" onAction="#handleDeal" HBox.hgrow="ALWAYS" maxWidth="Infinity" style="-fx-background-radius: 0;"/>
            <Button text="Restore" onAction="#handleRestore" HBox.hgrow="ALWAYS" maxWidth="Infinity" style="-fx-background-radius: 0;"/>
            <Button text="BattleHand" onAction="#handleBattleHand" HBox.hgrow="ALWAYS" maxWidth="Infinity" style="-fx-background-radius: 0;"/>
            <Button text="Weaken" onAction="#handleWeaken" HBox.hgrow="ALWAYS" maxWidth="Infinity" style="-fx-background-radius: 0;"/>
            <Button text="Exit" onAction="#handleExit" HBox.hgrow="ALWAYS" maxWidth="Infinity" style="-fx-background-radius: 0;"/>
        </HBox>

</VBox>