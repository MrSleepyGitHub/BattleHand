<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="controller.CardController"
      prefWidth="300.0" prefHeight="500.0" stylesheets="@/view/style.css" alignment="CENTER" spacing="15">

      <!-- Strength -->
      <Label fx:id="strengthLabel" style="-fx-font-weight: bold; -fx-font-size: 18pt"/>
      <!-- Name -->
      <Label fx:id="nameLabel" style="-fx-font-weight: bold; -fx-font-size: 18pt"/>
      <!-- Type -->
      <Label fx:id="typeLabel" style="-fx-font-weight: bold; -fx-font-size: 18pt"/>

      <Region VBox.vgrow="ALWAYS"/>
      <Separator/>

      <Button text="Close" onAction="#handleClose" HBox.hgrow="ALWAYS" maxWidth="Infinity" style="-fx-background-radius: 0;"/>

</VBox>