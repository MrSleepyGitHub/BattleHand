<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<VBox xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.BattleController"
            prefWidth="700.0" prefHeight="500.0" stylesheets="@/view/style.css" alignment="CENTER" spacing="15">

      <!-- Header -->
      <Label styleClass="padding-medium" style="-fx-font-weight: bold; -fx-font-size: 18pt">Battle Hand</Label>
      <Separator/>

      <HBox alignment="CENTER" spacing="5">
            <Label text="Total Strength:"/>
            <Label text="${controller.battleHand.strengthProperty}"/>
      </HBox>

      <ListView fx:id="cardsList" items="${controller.battleHand.cards}" VBox.vgrow="ALWAYS"/>
      <!-- ToDo add cool card graphics here -->

      <Region VBox.vgrow="ALWAYS"/>

      <Separator/>

      <Button text="Close" onAction="#handleClose" HBox.hgrow="ALWAYS" maxWidth="Infinity" style="-fx-background-radius: 0;"/>
           

</VBox>